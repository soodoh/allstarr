{
	"name": "allstarr",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "bun .output/server/index.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"prepare": "bun scripts/prepare-hooks.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e:install": "bunx playwright install chromium",
		"test:e2e": "bun run test:e2e:install && bunx playwright test --config e2e/playwright.config.ts",
		"fixtures:capture": "bun scripts/capture-golden-fixtures.ts",
		"fixtures:capture:compose-live": "bun scripts/capture-compose-live-fixtures.ts",
		"fixtures:promote:compose-live": "bun scripts/promote-compose-live-fixtures.ts"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-router": "^1.170.17",
		"@tanstack/react-router-ssr-query": "^1.167.1",
		"@tanstack/react-start": "^1.168.27",
		"@unpic/react": "^1.0.2",
		"adm-zip": "^0.6.0",
		"better-auth": "^1.6.23",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.2",
		"fast-xml-parser": "^5.10.0",
		"fuzzball": "^2.2.6",
		"lucide-react": "^1.24.0",
		"next-themes": "^0.4.6",
		"nitro": "^3.0.260311-beta",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sharp": "^0.35.3",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@commitlint/types": "^21.2.0",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.2",
		"@types/adm-zip": "^0.5.8",
		"@types/better-sqlite3": "^7.6.13",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"better-sqlite3": "^13.0.3",
		"drizzle-kit": "^0.31.10",
		"lefthook": "^2.1.10",
		"tailwindcss": "^4.3.2",
		"typescript": "^7.0.2",
		"vite": "^8.1.4",
		"vitest": "4.1.10",
		"vitest-browser-react": "^2.2.0"
	},
	"patchedDependencies": {
		"@vitest/browser@4.1.4": "patches/@vitest%2Fbrowser@4.1.4.patch"
	}
}
